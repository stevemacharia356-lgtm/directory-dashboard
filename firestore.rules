rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /directories/{directoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /nicheFields/{nicheSlug} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}